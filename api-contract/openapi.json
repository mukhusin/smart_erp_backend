{
    "openapi": "3.1.2",
    "info": {
        "title": "Smart ERP",
        "version": "1.0.0",
        "description": "Smart ERP backend API. The only contract between the backend and the Angular frontend."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "operationId": "auth.login",
                "description": "Call `GET /sanctum/csrf-cookie` first, then send the `X-XSRF-TOKEN` header.\nReturns the same data as `GET /me`.",
                "summary": "Log in (SPA cookie session)",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MeResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "summary": "Log out",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "me",
                "description": "User, linked employee, company, modules enabled for the company, roles and permissions.\nThe frontend builds its menu and hides actions from this; the API still checks every request.",
                "summary": "Current user",
                "tags": [
                    "Auth",
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MeResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "description": "Username or email address.",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 100
                    }
                },
                "required": [
                    "username",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "MeResource": {
                "type": "object",
                "properties": {
                    "user": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            },
                            "username": {
                                "type": "string"
                            },
                            "email": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "avatar_url": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "username",
                            "email",
                            "avatar_url"
                        ]
                    },
                    "employee": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "employee_no": {
                                "type": "string"
                            },
                            "full_name": {
                                "type": "string"
                            },
                            "department_id": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "job_position_id": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "employee_no",
                            "full_name",
                            "department_id",
                            "job_position_id"
                        ]
                    },
                    "company": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "name"
                        ]
                    },
                    "modules": {
                        "type": "array",
                        "description": "Modules the user's company can use (core modules are always included).",
                        "items": {
                            "$ref": "#/components/schemas/ModuleResource"
                        }
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "permissions": {
                        "type": "array",
                        "description": "Permission names, e.g. \"leave.approve\".",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "user",
                    "employee",
                    "company",
                    "modules",
                    "roles",
                    "permissions"
                ],
                "title": "MeResource"
            },
            "ModuleResource": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string",
                        "description": "Key used by the frontend module manifest, e.g. \"leave\"."
                    },
                    "name": {
                        "type": "string"
                    },
                    "icon": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Bootstrap Icons name without the \"bi-\" prefix, e.g. \"person-circle\"."
                    },
                    "category": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "slug",
                    "name",
                    "icon",
                    "category"
                ],
                "title": "ModuleResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}